# ──────────────────────────────────────────────────────────────────────────
# Пример конфигурации. Скопируй в .env и заполни. .env в VCS НЕ коммитится.
# Никаких реальных секретов в этом файле-примере.
# ──────────────────────────────────────────────────────────────────────────

# --- Postgres (реестр + аудит + RBAC) ---
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_DB=mlsec
POSTGRES_USER=mlsec_app          # роль приложения: БЕЗ прав UPDATE/DELETE на events
POSTGRES_PASSWORD=change_me

# --- MinIO (S3) ---
MINIO_ENDPOINT=http://minio:9000
MINIO_ACCESS_KEY=change_me
MINIO_SECRET_KEY=change_me
MINIO_BUCKET_DATASETS=datasets
MINIO_BUCKET_QUARANTINE=quarantine
MINIO_BUCKET_MODELS=models
MINIO_BUCKET_MLFLOW=mlflow

# --- Redis (rate-limit / cache) ---
REDIS_URL=redis://redis:6379/0

# --- MLflow (за auth-прокси, наружу не публикуется) ---
MLFLOW_TRACKING_URI=http://authproxy:4180/mlflow
MLFLOW_S3_ENDPOINT_URL=http://minio:9000
# Куда наш /mlflow-прокси (src/api/mlflow_proxy.py) проксирует запросы.
# Локальный дев без Docker: указывает на локальный mlflow server.
MLFLOW_UPSTREAM_URL=http://127.0.0.1:5000

# --- Локальный дев без Docker ---
# Бэкенд БД: sqlite (дев) | postgres (compose)
DB_BACKEND=sqlite
# Секрет для подписи JWT (в проде — длинный случайный, не коммитить)
JWT_SECRET=dev-insecure-change-me
# Пароль bootstrap-админа (для infra/seed_admin.py)
BOOTSTRAP_ADMIN_PASSWORD=admin-pass

# --- Auth / Identity (SSO) ---
# Прокси серверно проставляет X-Authenticated-User. Клиент его задать не может.
AUTH_PROXY_HEADER=X-Authenticated-User
OIDC_ISSUER=http://idp:8080/realms/mlsec
OIDC_CLIENT_ID=mlsec-platform
OIDC_CLIENT_SECRET=change_me

# --- Bootstrap первого админа (debug-сид) ---
BOOTSTRAP_ADMIN_USER=msecops
BOOTSTRAP_ADMIN_EMAIL=msecops@example.com

# --- Режим разработчика / demo-переключатель ролей ---
# В боевом конфиге ДОЛЖНО быть false (иначе обход RBAC).
APP_DEBUG=true

# --- CI/CD (GitHub Actions) ---
GITHUB_REPO=org/mlsecopus
GITHUB_TOKEN=change_me           # только в окружении/secrets, не в коде
COSIGN_PUBLIC_KEY_PATH=/keys/cosign.pub
