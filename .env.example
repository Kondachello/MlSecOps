# ──────────────────────────────────────────────────────────────────────────
# Пример конфигурации. Скопируй в .env и заполни. .env в VCS НЕ коммитится.
# Никаких реальных секретов в этом файле-примере.
# ──────────────────────────────────────────────────────────────────────────

# --- Postgres (реестр + аудит + RBAC) ---
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_DB=mlsec
MLFLOW_POSTGRES_DB=mlflow
POSTGRES_USER=mlsec_app          # роль приложения: БЕЗ прав UPDATE/DELETE на events
POSTGRES_PASSWORD=change_me

# --- MinIO (S3) ---
MINIO_ENDPOINT=http://minio:9000
MINIO_ACCESS_KEY=change_me
MINIO_SECRET_KEY=change_me
MINIO_BUCKET_DATASETS=datasets
MINIO_BUCKET_QUARANTINE=quarantine
MINIO_BUCKET_MODELS=models
MINIO_BUCKET_MLFLOW=mlflow

# --- Redis (rate-limit / cache) ---
REDIS_URL=redis://redis:6379/0

# --- MLflow (внутри compose: server mlflow:5000; SDK/ноутбук — через Gatekeeper) ---
MLFLOW_UPSTREAM_URL=http://mlflow:5000
MLFLOW_TRACKING_URI=http://localhost:8000/mlflow
GATEKEEPER_PUBLIC_URL=http://localhost:8000
MLFLOW_S3_ENDPOINT_URL=http://minio:9000

# --- Auth / Identity (SSO) ---
# Прокси серверно проставляет X-Authenticated-User. Клиент его задать не может.
AUTH_PROXY_HEADER=X-Authenticated-User
OIDC_ISSUER=http://idp:8080/realms/mlsec
OIDC_CLIENT_ID=mlsec-platform
OIDC_CLIENT_SECRET=change_me

# --- Bootstrap первого админа (debug-сид) ---
BOOTSTRAP_ADMIN_USER=msecops
BOOTSTRAP_ADMIN_EMAIL=msecops@example.com

# --- Docker UI (если :8501 занят локальным Streamlit) ---
# UI_HOST_PORT=8502

# --- Режим разработчика (обход RBAC — только локально) ---
APP_DEBUG=false
UI_USE_MOCKS=false

# --- GitHub Actions (runner: GitHub-hosted ubuntu-22.04, см. .github/workflows/*.yml) ---
# Эти три поля — для Gatekeeper (Docker backend): кнопки UI → repository_dispatch.
# В сами workflow jobs PAT не нужен: там уже есть встроенный secrets.GITHUB_TOKEN.
GITHUB_REPO=Kondachello/MlSecOps
GITHUB_TOKEN=change_me             # PAT: права repo + workflow (только в .env бэка, НЕ в git!)
GITHUB_REF=main                    # ветка, на которой гоняем verify/train/deploy

# Self-hosted runner (docker profile ci) — НЕ используем при GitHub-hosted:
# REPO_URL=...
# ACCESS_TOKEN=...
# RUNNER_NAME=...

# --- Gatekeeper (скрипты CI → бэкенд) ---
# В Actions: secrets/vars GATEKEEPER_URL (публичный URL бэка), CI_INGEST_TOKEN
GATEKEEPER_URL=http://backend:8000
USE_GATEKEEPER=true                # preflight/register/ingest через API
CI_INGEST_TOKEN=change_me          # тот же secret в GitHub Actions
CI_SKIP_DB_SMOKE=true              # true на GitHub-hosted без Postgres

# HITL: сколько approve нужно перед deploy
HITL_APPROVALS_HIGH=2
HITL_APPROVALS_EXTERNAL=2
HITL_APPROVALS_DEFAULT=1

# Локальное хранилище если MinIO недоступен
STORAGE_LOCAL_ROOT=./storage_local

# cosign — GitHub Actions Secrets (не в .env):
# COSIGN_PRIVATE_KEY=...
# COSIGN_PUBLIC_KEY=...
# COSIGN_PASSWORD=...
COSIGN_PUBLIC_KEY_PATH=/keys/cosign.pub
