# UI (Streamlit).
FROM python:3.11-slim
WORKDIR /app
COPY ui/requirements.txt .
RUN pip install --no-cache-dir -r requirements.txt
# В compose `..:/app` bind-mount-ится поверх (см. docker-compose.yml, сервис ui) — правки
# в ui/*.py подхватываются мгновенно без rebuild. COPY оставлен для standalone-запусков.
COPY ui/ ./ui/
COPY src/ ./src/
COPY core/ ./core/
EXPOSE 8501
CMD ["streamlit", "run", "ui/app.py", "--server.port", "8501", "--server.address", "0.0.0.0"]
