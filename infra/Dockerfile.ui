# Образ Streamlit-UI (Шаг 3). Контекст сборки = корень репозитория.
FROM python:3.11-slim

WORKDIR /app

# Зеркало PyPI можно переопределить при сборке:
#   docker compose build --build-arg PIP_INDEX_URL=https://mirror.timeweb.cloud/pypi/simple/
ARG PIP_INDEX_URL=https://pypi.org/simple
ENV PIP_INDEX_URL=${PIP_INDEX_URL} \
    PIP_DEFAULT_TIMEOUT=120 \
    PIP_RETRIES=10

COPY ui/requirements.txt ./ui/requirements.txt
RUN python -m pip install --no-cache-dir --upgrade pip && \
    pip install --no-cache-dir --retries 10 --timeout 120 -r ui/requirements.txt

COPY core/ ./core/
COPY ui/ ./ui/

ENV PYTHONPATH=/app
EXPOSE 8501

CMD ["streamlit", "run", "ui/app.py", \
     "--server.port=8501", "--server.address=0.0.0.0", \
     "--browser.gatherUsageStats=false"]
