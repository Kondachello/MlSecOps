# Образ gates-runner: Python + gitleaks + ML-стек для запуска security-гейтов.
# Контейнер ДОЛГОЖИВУЩИЙ (tail -f /dev/null); бэкенд по кнопке делает
# `docker compose exec gates-runner python -m gates.runner --run-id X`.
#
# Тяжёлые зависимости (onnxruntime/pandas/sklearn) предзагружены — старт гейтов мгновенный.
FROM python:3.11-slim AS gates

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    PIP_DISABLE_PIP_VERSION_CHECK=1 \
    PIP_NO_CACHE_DIR=1

# 1) CLI-сканеры. gitleaks для G0 — production-grade.
#    Версия пиннится для воспроизводимости. arm64/amd64 — автоматически по uname.
ARG GITLEAKS_VERSION=8.21.2
RUN apt-get update && apt-get install -y --no-install-recommends \
        ca-certificates curl tar tini \
    && rm -rf /var/lib/apt/lists/* \
    && ARCH=$(uname -m) \
    && case "$ARCH" in \
         x86_64) GL_ARCH=x64 ;; \
         aarch64) GL_ARCH=arm64 ;; \
         *) echo "unsupported arch $ARCH" >&2 && exit 1 ;; \
       esac \
    && curl -sSL -o /tmp/gl.tar.gz \
        "https://github.com/gitleaks/gitleaks/releases/download/v${GITLEAKS_VERSION}/gitleaks_${GITLEAKS_VERSION}_linux_${GL_ARCH}.tar.gz" \
    && tar -xzf /tmp/gl.tar.gz -C /usr/local/bin gitleaks \
    && rm /tmp/gl.tar.gz \
    && gitleaks version

# 2) Python-зависимости.
#    Минимум: mlflow (для скачивания артефактов), onnxruntime (G8), pandas/numpy (G8/DATA),
#    pyyaml (gates.yml), boto3 (если MLflow держит артефакты в MinIO/S3).
WORKDIR /app
COPY infra/gates-requirements.txt /app/infra/gates-requirements.txt
RUN pip install --upgrade pip \
 && pip install -r /app/infra/gates-requirements.txt

# 3) Копируем код. В compose эту папку будем маунтить /app, но в standalone-режиме
#    (без compose) образ самодостаточен.
COPY . /app
ENV PYTHONPATH=/app

# Долгоживущий контейнер: ждём `docker compose exec`. tini — корректный PID1.
ENTRYPOINT ["/usr/bin/tini", "--"]
CMD ["tail", "-f", "/dev/null"]
