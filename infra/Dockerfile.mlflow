# MLflow Tracking + Model Registry (backend=Postgres, artifact-store=MinIO).
# Слушает внутри сети; наружу — только через authproxy.
FROM python:3.11-slim
WORKDIR /app
RUN pip install --no-cache-dir mlflow psycopg2-binary boto3
EXPOSE 5000
# Backend-store и artifact-root задаются через окружение/аргументы при запуске.
# TODO: подставить --backend-store-uri postgresql://... и --default-artifact-root s3://mlflow
CMD ["mlflow", "server", "--host", "0.0.0.0", "--port", "5000"]
