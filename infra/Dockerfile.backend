# Бэкенд / Gatekeeper и инференс (FastAPI). Без mlflow/streamlit — быстрая сборка.
FROM python:3.11-slim
WORKDIR /app
RUN groupadd -r mlsec && useradd -r -g mlsec -u 10001 mlsec
RUN pip install --no-cache-dir \
    "fastapi>=0.110" \
    "uvicorn[standard]>=0.27" \
    "pydantic>=2" \
    "psycopg[binary]>=3.1" \
    "redis>=5" \
    "pandas>=2" \
    "requests>=2.31" \
    "python-dotenv>=1.0" \
    "httpx>=0.27" \
    "python-multipart>=0.0.9" \
    "python-jose[cryptography]>=3.3" \
    "bcrypt>=4.1" \
    "onnxruntime>=1.17" \
    "numpy>=1.26" \
    "mlflow>=2.9" \
    "boto3>=1.34"
COPY core/ ./core/
COPY src/ ./src/
COPY scripts/ ./scripts/
COPY data/make_datasets.py ./data/make_datasets.py
COPY infra/seed_admin.py ./infra/seed_admin.py
RUN chown -R mlsec:mlsec /app
USER 10001
EXPOSE 8000
